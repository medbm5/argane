# Committed defaults only — safe values for local development.
# Real secrets go in .env.local (git-ignored) or in the hosting provider's env.
#
# Load order: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local
# Real environment variables win over .env files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Host default targets the compose MySQL on 127.0.0.1:3307; the backend container overrides it.
DATABASE_URL="mysql://argane:argane@127.0.0.1:3307/argane?serverVersion=8.0&charset=utf8mb4"
# Aiven CA certificate, base64-encoded (production only)
DATABASE_SSL_CA_BASE64=
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> clerk ###
# Values from the Clerk dashboard (API keys page). Real keys go in .env.local.
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=
# Comma-separated origins allowed in the token `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
###< clerk ###

###> identity ###
# Comma-separated emails granted staff roles when the account is first created.
ORGANIZER_EMAILS=
BOX_OFFICE_EMAILS=
###< identity ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> stripe/stripe-php ###
# Test-mode keys go in .env.local (never commit them). The webhook secret is printed by
# `docker compose up stripe-cli` (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< stripe/stripe-php ###

###> google sheets ###
# Optional box office spreadsheet sync. See INSTALL.md (Google Cloud service account).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
###< google sheets ###
