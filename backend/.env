# Committed defaults only — safe values for local development.
# Real secrets go in .env.local (git-ignored) or in the hosting provider's env.
#
# Load order: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local
# Real environment variables win over .env files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Host default targets the compose MySQL on 127.0.0.1:3307; the backend container overrides it.
DATABASE_URL="mysql://argane:argane@127.0.0.1:3307/argane?serverVersion=8.0&charset=utf8mb4"
# Aiven CA certificate, base64-encoded (production only)
DATABASE_SSL_CA_BASE64=
###< doctrine/doctrine-bundle ###
